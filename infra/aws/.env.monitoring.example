# ---------------------------------------------------------------------------
# Grafana Cloud monitoring credentials — example / template
# ---------------------------------------------------------------------------
# NEVER commit the real .env.monitoring file. Create it on the production VM
# at /opt/adept/.env.monitoring and restrict its permissions (chmod 600).
#
# Copy endpoints and instance IDs from your Grafana Cloud stack:
#   https://grafana.com/orgs/<your-org>/stacks
#
# GRAFANA_CLOUD_METRICS_USER  — the numeric Prometheus instance ID
#   (not your Grafana Cloud login email)
# GRAFANA_CLOUD_LOGS_USER     — the numeric Loki instance ID
# GRAFANA_CLOUD_TOKEN         — a scoped Access Policy token with
#   metrics:write only for PR 1; add logs:write in PR 3 (not an admin token)
# Leave both LOGS values blank until the log-collection PR is installed.
#
# These variables are consumed exclusively by the Alloy collector container.
# They are never injected into the application services.
# ---------------------------------------------------------------------------

GRAFANA_CLOUD_METRICS_URL=
GRAFANA_CLOUD_METRICS_USER=
GRAFANA_CLOUD_LOGS_URL=
GRAFANA_CLOUD_LOGS_USER=
GRAFANA_CLOUD_TOKEN=
