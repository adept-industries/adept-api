// Adept production monitoring. Grafana credentials come only from
// /opt/adept/.env.monitoring through the Alloy service env_file.
prometheus.remote_write "grafana_cloud" {
	external_labels = {environment = "production", instance = "adept-production"}

	endpoint {
		url = sys.env("GRAFANA_CLOUD_METRICS_URL")

		basic_auth {
			username = sys.env("GRAFANA_CLOUD_METRICS_USER")
			password = sys.env("GRAFANA_CLOUD_TOKEN")
		}

		queue_config {
			capacity             = 5000
			min_shards           = 1
			max_shards           = 2
			max_samples_per_send = 1000
			batch_send_deadline  = "5s"
		}
	}
	// Retention is time-based, NOT a hard disk-size cap. Allow for truncation
	// delay and WAL segment overhead; monitor free disk and remote-write errors.
	wal {
		truncate_frequency = "15m"
		min_keepalive_time = "5m"
		max_keepalive_time = "1h"
	}
}

// Log delivery has a small in-memory batch/retry budget. Docker's existing
// 10 MiB x 5-file rotation is the on-host bound; Alloy persists read positions
// in its storage volume so collector restarts resume from the last offset.
loki.write "grafana_cloud" {
	external_labels = {environment = "production"}
	max_streams     = 16

	endpoint {
		url                 = sys.env("GRAFANA_CLOUD_LOGS_URL")
		batch_size          = "512KiB"
		batch_wait          = "2s"
		min_backoff_period  = "500ms"
		max_backoff_period  = "30s"
		max_backoff_retries = 10

		basic_auth {
			username = sys.env("GRAFANA_CLOUD_LOGS_USER")
			password = sys.env("GRAFANA_CLOUD_TOKEN")
		}
	}
}

// Host mounts refer to the Linux Docker host, not Alloy's own namespaces.
prometheus.exporter.unix "host" {
	procfs_path    = "/rootfs/proc"
	sysfs_path     = "/sys"
	rootfs_path    = "/rootfs"
	set_collectors = [
		"cpu", "meminfo", "diskstats", "filesystem", "loadavg", "stat", "uname",
	]

	filesystem {
		fs_types_exclude     = "^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|fusectl|hugetlbfs|iso9660|mqueue|nsfs|overlay|proc|procfs|pstore|rpc_pipefs|securityfs|selinuxfs|squashfs|sysfs|tracefs)$"
		mount_points_exclude = "^/(dev|proc|run|sys|var/lib/docker)($|/)"
	}
}

prometheus.scrape "host_metrics" {
	sample_limit    = 5000
	targets         = prometheus.exporter.unix.host.targets
	forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
	scrape_interval = "60s"
	scrape_timeout  = "15s"
	job_name        = "node-exporter"
}

// Docker socket access is root-equivalent even with a :ro mount. Never expose
// this collector publicly. Do not collect environment values or arbitrary labels.
prometheus.exporter.cadvisor "containers" {
	docker_host = "unix:///var/run/docker.sock"
	// Docker's managed containerd socket is needed for its overlayfs image store.
	containerd_host              = "/rootfs/var/run/docker/containerd/containerd.sock"
	docker_only                  = true
	store_container_labels       = false
	allowlisted_container_labels = ["com.docker.compose.project", "com.docker.compose.service"]
	enabled_metrics              = ["cpu", "memory", "network", "diskIO"]
	storage_duration             = "1m"
}

prometheus.scrape "container_metrics" {
	sample_limit    = 10000
	targets         = prometheus.exporter.cadvisor.containers.targets
	forward_to      = [prometheus.relabel.container_metrics.receiver]
	scrape_interval = "60s"
	scrape_timeout  = "30s"
	job_name        = "cadvisor"
}

prometheus.relabel "container_metrics" {
	forward_to = [prometheus.remote_write.grafana_cloud.receiver]

	rule {
		source_labels = ["__name__", "container_label_com_docker_compose_project"]
		regex         = "(up|scrape_.*);|.*;adept-production"
		action        = "keep"
	}

	rule {
		source_labels = ["container_label_com_docker_compose_service"]
		target_label  = "service"
	}
	// Keep resource usage, last-seen and start-time signals, not the full exporter.
	rule {
		source_labels = ["__name__"]
		regex         = "up|scrape_.*|container_(cpu_usage_seconds_total|cpu_cfs_periods_total|cpu_cfs_throttled_periods_total|memory_working_set_bytes|memory_usage_bytes|memory_swap|spec_memory_limit_bytes|network_receive_bytes_total|network_transmit_bytes_total|fs_reads_bytes_total|fs_writes_bytes_total|last_seen|start_time_seconds)"
		action        = "keep"
	}

	rule {
		regex  = "container_label_.*"
		action = "labeldrop"
	}
}

prometheus.scrape "api_metrics" {
	sample_limit    = 10000
	targets         = [{__address__ = "api:8080"}]
	metrics_path    = "/actuator/prometheus"
	forward_to      = [prometheus.relabel.api_metrics.receiver]
	scrape_interval = "60s"
	scrape_timeout  = "15s"
	job_name        = "adept-api"
}

prometheus.relabel "api_metrics" {
	forward_to = [prometheus.remote_write.grafana_cloud.receiver]

	rule {
		source_labels = ["__name__"]
		regex         = "up|scrape_.*|http_server_requests_seconds.*|jvm_.*|process_.*|hikaricp_.*|jdbc_connections_.*"
		action        = "keep"
	}
}

// This is the worker process from adept-engine, not the Engine API. Port 8001
// has no host mapping and is reachable only across the Compose bridge network.
prometheus.scrape "engine_worker_metrics" {
	sample_limit    = 5000
	targets         = [{__address__ = "engine-worker:8001"}]
	metrics_path    = "/metrics"
	forward_to      = [prometheus.relabel.engine_worker_metrics.receiver]
	scrape_interval = "60s"
	scrape_timeout  = "15s"
	job_name        = "adept-engine-worker"
}

prometheus.relabel "engine_worker_metrics" {
	forward_to = [prometheus.remote_write.grafana_cloud.receiver]

	rule {
		source_labels = ["__name__"]
		regex         = "up|scrape_.*|adept_engine_worker_.*"
		action        = "keep"
	}
}

// Discover this Compose project, then allow only selected services below.
// Multiple Docker label filters are ANDed, not ORed: filtering service=api
// AND service=engine-worker here would discover no containers at all.
discovery.docker "service_logs" {
	host             = "unix:///var/run/docker.sock"
	refresh_interval = "60s"

	filter {
		name   = "label"
		values = ["com.docker.compose.project=adept-production"]
	}
}

discovery.relabel "service_logs" {
	targets = discovery.docker.service_logs.targets

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
		regex         = "adept-production"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = "api|engine-api|engine-worker|caddy"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service"
	}
}

loki.source.docker "service_logs" {
	host             = "unix:///var/run/docker.sock"
	targets          = discovery.relabel.service_logs.output
	labels           = {environment = "production"}
	forward_to       = [loki.process.service_logs.receiver]
	refresh_interval = "60s"
}

loki.process "service_logs" {
	forward_to = [loki.write.grafana_cloud.receiver]

	// LOG_PIPELINE_STAGES_BEGIN -- mirrored by the local redaction fixture.
	// Fail closed: only reconstruct bounded operational summaries. Never forward
	// original messages, unknown JSON fields, exception text or stack traces.
	stage.drop {
		longer_than         = "16KB"
		drop_counter_reason = "oversized_line"
	}

	stage.json {
		expressions = {
			event     = "event",
			log_level = "level",
			status    = "to_string(status)",
		}
	}

	stage.regex {
		source     = "event"
		expression = "^(?P<safe_event>engine_worker_(pool_starting|starting|poll_failed|lease_failed|job_dispatch_failed|job_deferral_failed|metrics_update_failed|monitoring_start_failed|monitoring_stop_failed|monitoring_shutdown_timed_out|queue_metrics_collection_failed|queue_metrics_update_failed)|job_(execution_failed|permanent_failure|lease_connection_lost)|provider_job_execution_failed|unsupported_job_type_marked_dead|pr_risk_model_startup_failed|engine_readiness_failed)$"
	}

	stage.regex {
		source     = "log_level"
		expression = "^(?P<safe_level>error|warning|warn|ERROR|WARN)$"
	}

	// Spring Boot/Uvicorn plaintext: preserve only the severity, not the message.
	stage.regex {
		expression = "(^|[[:space:]])(?P<plain_level>WARN|ERROR)([[:space:]:]|$)"
	}

	stage.regex {
		source     = "status"
		expression = "^(?P<http_status>[45][0-9]{2})$"
	}

	// Initialize output first so a parsing/template failure cannot export raw text.
	stage.template {
		source   = "safe_line"
		template = "DROP_UNSELECTED"
	}

	stage.template {
		source   = "safe_line"
		template = "{{ if or .safe_event .safe_level .plain_level .http_status }}level={{ if or (eq .safe_level \"error\") (eq .safe_level \"ERROR\") (eq .plain_level \"ERROR\") }}error{{ else if or .safe_level .plain_level .http_status }}warning{{ else }}info{{ end }} event={{ if .safe_event }}{{ .safe_event }}{{ else if .http_status }}http_request_failed status={{ .http_status }}{{ else }}application_warning_or_error{{ end }}{{ else }}DROP_UNSELECTED{{ end }}"
	}

	stage.output {
		source = "safe_line"
	}

	stage.drop {
		expression          = "^DROP_UNSELECTED$"
		drop_counter_reason = "not_selected_operational_event"
	}

	stage.label_keep {
		values = ["environment", "service"]
	}

	stage.limit {
		rate          = 20
		burst         = 100
		drop          = true
		by_label_name = "service"
	}
	// LOG_PIPELINE_STAGES_END
}

// Collector failures must be visible too; readiness alone does not prove delivery.
prometheus.exporter.self "alloy" { }

prometheus.scrape "alloy_metrics" {
	sample_limit    = 5000
	targets         = prometheus.exporter.self.alloy.targets
	forward_to      = [prometheus.relabel.alloy_metrics.receiver]
	scrape_interval = "60s"
	scrape_timeout  = "15s"
	job_name        = "alloy"
}

prometheus.relabel "alloy_metrics" {
	forward_to = [prometheus.remote_write.grafana_cloud.receiver]

	rule {
		source_labels = ["__name__"]
		regex         = "up|scrape_.*|process_resident_memory_bytes|process_cpu_seconds_total|prometheus_remote_storage_.*|prometheus_wal_.*|loki_.*"
		action        = "keep"
	}
}
