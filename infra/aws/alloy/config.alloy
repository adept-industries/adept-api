// ---------------------------------------------------------------------------
// Grafana Alloy configuration — Adept monitoring, PR 1
// ---------------------------------------------------------------------------
// Credentials are read from environment variables supplied by Compose through
// the service-level env_file directive. They are never hard-coded here.
//
// Topology:
//   VM (node exporter) ─┐
//   Docker containers   ├─► Alloy ──► Grafana Cloud (metrics remote-write)
//   API /actuator/prom  ┘
//
// Collection interval: 60 s for all scrape targets.
// Resource bounds: WAL kept under 1 GiB; no unbounded label cardinality.
// ---------------------------------------------------------------------------

// ── Prometheus remote-write to Grafana Cloud ──────────────────────────────

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = env("GRAFANA_CLOUD_METRICS_URL")

    basic_auth {
      username = env("GRAFANA_CLOUD_METRICS_USER")
      password = env("GRAFANA_CLOUD_TOKEN")
    }

    queue_config {
      // Bound the in-memory and WAL queue so Alloy cannot consume unbounded
      // disk on a low-capacity VM.
      max_samples_per_send = 2000
      batch_send_deadline  = "5s"
    }
  }

  wal {
    // Keep at most 1 h of unsent data on disk, capped at ~1 GiB via segment limits.
    truncate_frequency = "2h"
    min_keepalive_time = "5m"
    max_keepalive_time = "1h"
  }
}

// ── Node exporter — host CPU, memory, swap, disk, network ────────────────
// The Alloy container mounts the host root at /rootfs (read-only).
// Alloy's built-in node exporter component uses this mount to read
// /proc and /sys, producing metrics that describe the VM, not the container.

prometheus.exporter.unix "host" {
  procfs_path = "/rootfs/proc"
  sysfs_path  = "/rootfs/sys"
  rootfs_path = "/rootfs"

  // Include only the collector sets we actively use in dashboards.
  // Disabling unused collectors reduces label cardinality and CPU cost.
  enable_collectors = [
    "cpu",
    "meminfo",
    "diskstats",
    "filesystem",
    "loadavg",
    "netdev",
    "stat",
    "time",
    "uname",
  ]

  filesystem {
    // Ignore pseudo filesystems to avoid noise.
    fs_types_exclude     = "^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|fusectl|hugetlbfs|iso9660|mqueue|nsfs|overlay|proc|procfs|pstore|rpc_pipefs|securityfs|selinuxfs|squashfs|sysfs|tracefs)$"
    mount_points_exclude = "^/(dev|proc|run/credentials/.+|sys|var/lib/docker/.+)($|/)"
  }
}

prometheus.scrape "host_metrics" {
  targets    = prometheus.exporter.unix.host.targets
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]

  scrape_interval = "60s"
  scrape_timeout  = "15s"

  // Attach a stable job label so dashboards can filter by target type.
  job_name = "node-exporter"
}

// ── cAdvisor — Docker container resource and status metrics ───────────────
// The Docker socket mount gives cAdvisor access to running container stats.
// NOTE: Mounting /var/run/docker.sock read-only does not restrict which
// Docker API operations the process can call; it merely prevents file writes
// to the socket path. Alloy's cAdvisor component queries the Docker daemon
// API. Ensure Alloy runs with the minimum required Linux capabilities and
// that the Docker daemon socket is not exposed to the public internet.

prometheus.exporter.cadvisor "containers" {
  docker_host            = "unix:///var/run/docker.sock"
  store_container_labels = false  // prevent high-cardinality label explosion

  // Restrict to the metric families used in dashboards; drop the rest.
  enabled_metrics = [
    "cpu",
    "memory",
    "network",
    "diskio",
    "oom_event",
  ]
}

prometheus.scrape "container_metrics" {
  targets    = prometheus.exporter.cadvisor.containers.targets
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]

  scrape_interval = "60s"
  scrape_timeout  = "30s"

  job_name = "cadvisor"
}

// ── Spring API — /actuator/prometheus ────────────────────────────────────
// Alloy scrapes the API's Micrometer/Prometheus endpoint on the private
// Docker network. The endpoint is protected by the internalMetricsFilterChain
// in SecurityConfig (Order 1) which allows RFC-1918 addresses only.
// No host port is published for this path.

prometheus.scrape "api_metrics" {
  targets = [{
    __address__ = "api:8080",
  }]
  metrics_path = "/actuator/prometheus"
  forward_to   = [prometheus.remote_write.grafana_cloud.receiver]

  scrape_interval = "60s"
  scrape_timeout  = "15s"

  job_name = "adept-api"
}
