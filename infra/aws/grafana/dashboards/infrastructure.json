{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Host and container resource signals exported by Adept's private Alloy collector. Container health and restart panels are explicitly telemetry-derived proxies.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "description": "Five-minute non-idle CPU average for the host.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 75}, {"color": "red", "value": 90}]},
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"editorMode": "code", "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{environment=~\"$environment\",job=\"node-exporter\",mode=\"idle\"}[5m])))", "legendFormat": "CPU", "range": true, "refId": "A"}],
      "title": "Host CPU used",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "description": "RAM in use, based on MemAvailable rather than free-only memory.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 75}, {"color": "red", "value": 90}]},
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"editorMode": "code", "expr": "100 * (1 - sum(node_memory_MemAvailable_bytes{environment=~\"$environment\",job=\"node-exporter\"}) / clamp_min(sum(node_memory_MemTotal_bytes{environment=~\"$environment\",job=\"node-exporter\"}), 1))", "legendFormat": "RAM", "range": true, "refId": "A"}],
      "title": "Host RAM used",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "description": "Zero is expected on a host with no configured swap.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 50}, {"color": "red", "value": 75}]},
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "id": 3,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"editorMode": "code", "expr": "100 * (sum(node_memory_SwapTotal_bytes{environment=~\"$environment\",job=\"node-exporter\"}) - sum(node_memory_SwapFree_bytes{environment=~\"$environment\",job=\"node-exporter\"})) / clamp_min(sum(node_memory_SwapTotal_bytes{environment=~\"$environment\",job=\"node-exporter\"}), 1)", "legendFormat": "Swap", "range": true, "refId": "A"}],
      "title": "Host swap used",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "description": "Root filesystem utilization. A separate alert fires when free space falls below 15%.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 75}, {"color": "red", "value": 85}]},
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "id": 4,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"editorMode": "code", "expr": "100 * (1 - sum(node_filesystem_avail_bytes{environment=~\"$environment\",job=\"node-exporter\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"}) / clamp_min(sum(node_filesystem_size_bytes{environment=~\"$environment\",job=\"node-exporter\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"}), 1))", "legendFormat": "Root disk", "range": true, "refId": "A"}],
      "title": "Root disk used",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "description": "A value close to zero means cAdvisor saw the container recently. This is a telemetry-freshness proxy, not Docker HEALTHCHECK status.",
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "custom": {"axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 15, "gradientMode": "none", "hideFrom": {"legend": false, "tooltip": false, "viz": false}, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "scaleDistribution": {"type": "linear"}, "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "none"}, "thresholdsStyle": {"mode": "off"}}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 180}]}, "unit": "s"},
        "overrides": []
      },
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 4},
      "id": 5,
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"editorMode": "code", "expr": "clamp_min(time() - max by (service) (container_last_seen{environment=~\"$environment\",job=\"cadvisor\",service!=\"\"}), 0)", "legendFormat": "{{service}}", "range": true, "refId": "A"}],
      "title": "Container telemetry freshness (health proxy)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "description": "Counts changes in each observed start timestamp over the selected range. Rapid restarts between 60-second scrapes can be missed; this is not a Docker restart counter.",
      "fieldConfig": {
        "defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "unit": "short"},
        "overrides": []
      },
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 4},
      "id": 6,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"editorMode": "code", "expr": "changes((max by (service) (container_start_time_seconds{environment=~\"$environment\",job=\"cadvisor\",service!=\"\"}))[$__range:1m])", "legendFormat": "{{service}}", "range": true, "refId": "A"}],
      "title": "Observed container start changes (restart proxy)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "custom": {"axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "hideFrom": {"legend": false, "tooltip": false, "viz": false}, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "scaleDistribution": {"type": "linear"}, "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "none"}, "thresholdsStyle": {"mode": "off"}}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "percent"},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 11},
      "id": 7,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"editorMode": "code", "expr": "100 * sum by (service) (rate(container_cpu_usage_seconds_total{environment=~\"$environment\",job=\"cadvisor\",service!=\"\"}[5m]))", "legendFormat": "{{service}}", "range": true, "refId": "A"}],
      "title": "Container CPU by service",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "custom": {"axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "hideFrom": {"legend": false, "tooltip": false, "viz": false}, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "scaleDistribution": {"type": "linear"}, "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "none"}, "thresholdsStyle": {"mode": "off"}}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "bytes"},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 11},
      "id": 8,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"editorMode": "code", "expr": "sum by (service) (container_memory_working_set_bytes{environment=~\"$environment\",job=\"cadvisor\",service!=\"\"})", "legendFormat": "{{service}}", "range": true, "refId": "A"}],
      "title": "Container working-set memory",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "custom": {"axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 5, "gradientMode": "none", "hideFrom": {"legend": false, "tooltip": false, "viz": false}, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "scaleDistribution": {"type": "linear"}, "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "none"}, "thresholdsStyle": {"mode": "off"}}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "Bps"},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 19},
      "id": 9,
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"editorMode": "code", "expr": "sum by (service) (rate(container_network_receive_bytes_total{environment=~\"$environment\",job=\"cadvisor\",service!=\"\"}[5m]))", "legendFormat": "{{service}} receive", "range": true, "refId": "A"},
        {"editorMode": "code", "expr": "sum by (service) (rate(container_network_transmit_bytes_total{environment=~\"$environment\",job=\"cadvisor\",service!=\"\"}[5m]))", "legendFormat": "{{service}} transmit", "range": true, "refId": "B"}
      ],
      "title": "Container network I/O",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "custom": {"axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 5, "gradientMode": "none", "hideFrom": {"legend": false, "tooltip": false, "viz": false}, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "scaleDistribution": {"type": "linear"}, "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "none"}, "thresholdsStyle": {"mode": "off"}}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "Bps"},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 19},
      "id": 10,
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"editorMode": "code", "expr": "sum by (service) (rate(container_fs_reads_bytes_total{environment=~\"$environment\",job=\"cadvisor\",service!=\"\"}[5m]))", "legendFormat": "{{service}} read", "range": true, "refId": "A"},
        {"editorMode": "code", "expr": "sum by (service) (rate(container_fs_writes_bytes_total{environment=~\"$environment\",job=\"cadvisor\",service!=\"\"}[5m]))", "legendFormat": "{{service}} write", "range": true, "refId": "B"}
      ],
      "title": "Container disk I/O",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "loki", "uid": "${logs}"},
      "description": "Redacted Caddy and collector operational logs. Only environment and service are stream labels.",
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 27},
      "id": 11,
      "options": {"dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": false, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true},
      "targets": [{"editorMode": "code", "expr": "{environment=~\"$environment\",service=~\"caddy|alloy\"}", "queryType": "range", "refId": "A"}],
      "title": "Infrastructure operational logs",
      "type": "logs"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 41,
  "tags": ["adept", "infrastructure", "monitoring"],
