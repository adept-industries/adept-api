      "targets": [{"editorMode": "code", "expr": "100 * (sum(rate(http_server_requests_seconds_count{environment=~\"$environment\",job=\"adept-api\",status=~\"5..\"}[5m])) or (0 * sum(rate(http_server_requests_seconds_count{environment=~\"$environment\",job=\"adept-api\"}[5m])))) / clamp_min(sum(rate(http_server_requests_seconds_count{environment=~\"$environment\",job=\"adept-api\"}[5m])), 0.001)", "legendFormat": "5xx", "instant": true, "range": false, "refId": "A"}],
