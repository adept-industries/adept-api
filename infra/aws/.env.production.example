# Public hostname and ACME account contact. Do not include https:// in the domain.
ADEPT_DOMAIN=adeptindustries.dev
ACME_EMAIL=replace-with-monitored-email

# Use only immutable sha-<full-commit> tags published by the three repositories.
API_IMAGE=ghcr.io/adept-industries/adept-api:sha-0000000000000000000000000000000000000000
ENGINE_IMAGE=ghcr.io/adept-industries/adept-engine:sha-0000000000000000000000000000000000000000
FRONTEND_IMAGE=ghcr.io/adept-industries/adept-frontend:sha-0000000000000000000000000000000000000000

POSTGRES_DB=adept
POSTGRES_USER=adept
POSTGRES_PASSWORD=replace-with-a-unique-strong-password
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2

# Generate a different random value for every key. Never reuse local/CI values.
APP_JWT_SECRET_BASE64=replace-with-32-byte-base64-value
APP_TOKEN_HASH_PEPPER_BASE64=replace-with-32-byte-base64-value
APP_INTEGRATION_ENCRYPTION_KEY_V1_BASE64=replace-with-32-byte-base64-value
APP_INTEGRATION_ENCRYPTION_ACTIVE_KEY_VERSION=1
APP_INTERNAL_ENGINE_TOKEN=replace-with-a-unique-opaque-token

# Keep provider integrations disabled until their production applications and
# exact callbacks are configured.
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_INTEGRATION_ENABLED=false
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=
JIRA_INTEGRATION_ENABLED=false
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# Replace these with the ap-south-1 SES SMTP values after SES setup.
SPRING_MAIL_HOST=replace-with-ses-smtp-host
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=replace-with-ses-smtp-username
SPRING_MAIL_PASSWORD=replace-with-ses-smtp-password
APP_EMAIL_FROM=Adept <no-reply@adeptindustries.dev>

ENGINE_POLL_INTERVAL_MS=1000
ENGINE_WORKER_ID=adept-staging-worker-1
ENGINE_MAX_JOB_ATTEMPTS=8
