loki.echo "redaction_test" { }

loki.source.file "redaction_test" {
	targets = [{
		__path__    = "/fixtures/log-redaction-input.txt",
		service     = "api",
		environment = "production",
		request_id  = "FAKE_LABEL_VALUE",
	}]
	forward_to = [loki.process.service_logs.receiver]
}

loki.process "service_logs" {
	forward_to = [loki.echo.redaction_test.receiver]

	// LOG_PIPELINE_STAGES_BEGIN -- mirrored by the local redaction fixture.
	// Fail closed: only reconstruct bounded operational summaries. Never forward
	// original messages, unknown JSON fields, exception text or stack traces.
	stage.drop {
		longer_than         = "16KB"
		drop_counter_reason = "oversized_line"
	}

	stage.json {
		expressions = {
			event     = "event",
			log_level = "level",
			status    = "to_string(status)",
		}
	}

	stage.regex {
		source     = "event"
		expression = "^(?P<safe_event>engine_worker_(pool_starting|starting|poll_failed|lease_failed|job_dispatch_failed|job_deferral_failed|metrics_update_failed|monitoring_start_failed|monitoring_stop_failed|monitoring_shutdown_timed_out|queue_metrics_collection_failed|queue_metrics_update_failed)|job_(execution_failed|permanent_failure|lease_connection_lost)|provider_job_execution_failed|unsupported_job_type_marked_dead|pr_risk_model_startup_failed|engine_readiness_failed)$"
	}

	stage.regex {
		source     = "log_level"
		expression = "^(?P<safe_level>error|warning|warn|ERROR|WARN)$"
	}

	// Spring Boot/Uvicorn plaintext: preserve only the severity, not the message.
	stage.regex {
		expression = "(^|[[:space:]])(?P<plain_level>WARN|ERROR)([[:space:]:]|$)"
	}

	stage.regex {
		source     = "status"
		expression = "^(?P<http_status>[45][0-9]{2})$"
	}

	// Initialize output first so a parsing/template failure cannot export raw text.
	stage.template {
		source   = "safe_line"
		template = "DROP_UNSELECTED"
	}

	stage.template {
		source   = "safe_line"
		template = "{{ if or .safe_event .safe_level .plain_level .http_status }}level={{ if or (eq .safe_level \"error\") (eq .safe_level \"ERROR\") (eq .plain_level \"ERROR\") }}error{{ else if or .safe_level .plain_level .http_status }}warning{{ else }}info{{ end }} event={{ if .safe_event }}{{ .safe_event }}{{ else if .http_status }}http_request_failed status={{ .http_status }}{{ else }}application_warning_or_error{{ end }}{{ else }}DROP_UNSELECTED{{ end }}"
	}

	stage.output {
		source = "safe_line"
	}

	stage.drop {
		expression          = "^DROP_UNSELECTED$"
		drop_counter_reason = "not_selected_operational_event"
	}

	stage.label_keep {
		values = ["environment", "service"]
	}

	stage.limit {
		rate          = 20
		burst         = 100
		drop          = true
		by_label_name = "service"
	}
	// LOG_PIPELINE_STAGES_END
}
